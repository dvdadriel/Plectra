# Copy to .env and fill in what you have — or leave this alone and use the
# Settings page instead, which writes exactly this file. .env is gitignored,
# and it is read at startup so keys never appear in the process list.
# Variables already set in the environment win over anything here.
#
# Nothing here is required to play local music: point Plectra at your music
# folder in Settings, press Sync local music, and it plays.

# Where your music lives. Defaults to ~/Music. Settable in Settings, where it
# takes effect at once; -music on the command line overrides it.
PLECTRA_MUSIC=

# OpenSubsonic — the one surface reachable from the network, so it stays off
# until this is set. Any value turns the /rest API on for the user given by
# -subsonic-user (default "plectra"). Also accepted as subsonic-password.
PLECTRA_PASSWORD=

# Last.fm — a fallback for the chart rows on the home view. Without it charts
# come from ListenBrainz, which needs no key at all; the local recommendations
# do not use this either way. Also accepted as last-fm-api-key.
# Free key: https://www.last.fm/api/account/create
LASTFM_API_KEY=
