# Optional keys. Everything here can also be entered in Settings → Accounts,
# which stores them in the Plectra database instead. This file is read at
# startup and never overwrites variables already set in the environment.
#
# Copy to .env and fill in what you have. .env is gitignored.

# Spotify — playlists, liked songs, metadata. Create an app at
# https://developer.spotify.com/dashboard and register the redirect URI Plectra
# prints on startup. 32 hex characters each.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Last.fm — widens recommendations to artists that have no MusicBrainz id yet.
# Free key: https://www.last.fm/api/account/create
LASTFM_API_KEY=

# ListenBrainz — scrobbles finished plays. This is the *user token* from
# https://listenbrainz.org/settings/ — not a MetaBrainz application secret.
# Recommendations do not need it: ListenBrainz's similarity data is open.
LISTENBRAINZ_TOKEN=
